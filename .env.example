# Copy to .env and edit:  cp .env.example .env

# --- Postgres (local stand-in for RDS) ---
POSTGRES_USER=loan_admin
POSTGRES_PASSWORD=loan_pass_change_me
POSTGRES_DB=loan_engine

# --- Shared secret between Lambda -> n8n webhook and workflow B -> workflow C ---
WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- LLM (free Gemini key from https://aistudio.google.com/apikey). Optional: pipeline works without it,
#     near-miss pairs are then rejected conservatively and the unstructured lender page yields no products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Notification safety: emails go ONLY to these aliases, never to CSV addresses ---
# Replace "abcd" with your Gmail username.
TEST_EMAIL_ALIASES=abcd+one@gmail.com,abcd+two@gmail.com
SES_FROM_EMAIL=abcd@gmail.com
DEMO_MAX_EMAILS=5

# --- Optimization pipeline knobs ---
LLM_BATCH_SIZE=25
LLM_MAX_PAIRS=200

# --- Used by `serverless deploy` (local LocalStack values) ---
S3_ENDPOINT_PUBLIC=http://localhost:4566
S3_ENDPOINT_INTERNAL=http://localstack:4566
N8N_MATCH_WEBHOOK_URL=http://n8n:5678/webhook/match-users
DB_HOST=postgres
